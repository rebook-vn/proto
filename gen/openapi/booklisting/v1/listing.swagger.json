      "post": {
        "summary": "ScanBookCover accepts a stream of image chunks and returns a scan job ID.",
        "operationId": "BookListingService_ScanBookCover",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ScanBookCoverResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": " (streaming inputs)",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1ScanBookCoverRequest"
            }
          }
        ],
        "tags": [
          "BookListingService"
        ]
      }
    },
    "/api/v1/listings": {
      "post": {
        "summary": "CreateListing persists a new book listing from a completed scan.",
        "operationId": "BookListingService_CreateListing",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateListingResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateListingRequest"
            }
          }
        ],
        "tags": [
          "BookListingService"
        ]
      }
    },
    "/api/v1/listings/{listingId}": {
      "get": {
        "summary": "GetListing returns a public listing by id.",
        "operationId": "BookListingService_GetListing",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetListingResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "listingId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "BookListingService"
        ]
      }
    },
    "/api/v1/scans/{scanId}": {
      "get": {
        "summary": "GetScan returns the current state of a scan job.",
        "operationId": "BookListingService_GetScan",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetScanResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "scanId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "BookListingService"
        ]
      }
    },
    "/api/v1/scans/{scanId}/stream": {
      "get": {
        "summary": "StreamScan streams scan progress events until the job is terminal.",
        "operationId": "BookListingService_StreamScan",
        "responses": {
          "200": {
            "description": "A successful response.(streaming responses)",
            "schema": {
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/definitions/v1ScanEvent"
                },
                "error": {
                  "$ref": "#/definitions/rpcStatus"
                }
              },
              "title": "Stream result of v1ScanEvent"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "scanId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "BookListingService"
        ]
      }
    }
  },
