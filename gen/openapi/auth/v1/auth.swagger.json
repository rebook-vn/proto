{
  "swagger": "2.0",
  "info": {
    "title": "auth/v1/auth.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AuthService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/auth/logout": {
      "post": {
        "summary": "Logout revokes the refresh token in Hydra and the Kratos session.",
        "operationId": "AuthService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LogoutResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LogoutRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "GetMe returns the authenticated user's identity (phone, name).",
        "operationId": "AuthService_GetMe",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetMeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/otp/send": {
      "post": {
        "summary": "SendOTP initiates a Kratos Native login or registration flow for the\ngiven phone number and triggers the SMS courier (dev: code is always\n123456). Returns an opaque flow_token to be submitted with VerifyOTP.",
        "operationId": "AuthService_SendOTP",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SendOTPResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SendOTPRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/otp/verify": {
      "post": {
        "summary": "VerifyOTP submits the OTP code to Kratos, then drives the headless\nHydra OAuth2 flow server-side and returns access and refresh tokens.",
        "operationId": "AuthService_VerifyOTP",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1VerifyOTPResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1VerifyOTPRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/token/refresh": {
      "post": {
        "summary": "RefreshToken exchanges a refresh token for a new access token.",
        "operationId": "AuthService_RefreshToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RefreshTokenResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RefreshTokenRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/auth/validate": {
      "get": {
        "summary": "ValidateToken is called by Caddy forward_auth / Nginx auth-url on\nevery authenticated request. It introspects the Bearer token and\nsets the X-Identity-Sub HTTP response header on success.",
        "operationId": "AuthService_ValidateToken",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ValidateTokenResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "AuthService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1GetMeResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "Kratos identity ID (UUID)"
        },
        "phone": {
          "type": "string",
          "title": "E.164"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "v1LogoutRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "v1LogoutResponse": {
      "type": "object"
    },
    "v1RefreshTokenRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      }
    },
    "v1RefreshTokenResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "expiresIn": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1SendOTPRequest": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "title": "E.164: \"+84...\""
        },
        "name": {
          "type": "string",
          "title": "optional; required only on first registration"
        }
      }
    },
    "v1SendOTPResponse": {
      "type": "object",
      "properties": {
        "flowToken": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "title": "RFC3339"
        },
        "isNew": {
          "type": "boolean",
          "title": "true if no Kratos identity exists for this phone"
        }
      }
    },
    "v1ValidateTokenResponse": {
      "type": "object"
    },
    "v1VerifyOTPRequest": {
      "type": "object",
      "properties": {
        "flowToken": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "v1VerifyOTPResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "expiresIn": {
          "type": "string",
          "format": "int64"
        }
      }
    }
  }
}
